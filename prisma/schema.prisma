// Prisma schema for the standalone finance tracker.
// Maps to the same data model as the in-Claude artifact version.
// Run `npm run prisma:push` after setting DATABASE_URL to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Supabase, Neon, Railway, etc. all work here
  url      = env("DATABASE_URL")
}

model Category {
  id     String @id @default(cuid())
  name   String
  type   String // "income" | "expense"
  @@unique([name, type])
}

model Transaction {
  id             String   @id @default(cuid())
  type           String   // "income" | "expense"
  date           DateTime
  category       String
  amount         Float
  note           String?
  vendor         String?
  paymentMethod  String   @default("cash") // "cash" | "debit" | "card" | "check"
  cardId         String?
  bankAccountId  String?
  checkNumber    String?
  taxRate        Float?
  taxAmount      Float?
  receiptImage   String?  // base64 or a URL if you move to real file storage
  splitGroupId   String?
  splitIndex     Int?
  splitCount     Int?
  recurringId    String?
  tags           String?  // comma-separated, e.g. "tax deductible,reimbursable"
  deletedAt      DateTime? // soft-delete — set instead of removing, so it can be restored from Trash
  items          Item[]
  createdAt      DateTime @default(now())
}

model Item {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  name          String
  qty           Float
  unit          String
  unitPrice     Float
}

model Card {
  id         String   @id @default(cuid())
  name       String
  limit      Float    @default(0)
  dueDay     Int?
  amountDue  Float    @default(0)
  payments   CardPayment[]
}

model CardPayment {
  id            String   @id @default(cuid())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String
  date          DateTime
  amount        Float
  fromAccountId String?
  checkNumber   String?
  note          String?
}

model BankAccount {
  id      String @id @default(cuid())
  name    String
  balance Float  @default(0)
}

model Vendor {
  id   String @id @default(cuid())
  name String @unique
}

model Budget {
  id       String  @id @default(cuid())
  category String  @unique
  limit    Float
  rollover Boolean @default(false)
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Float
  targetDate   DateTime?
  savedAmount  Float     @default(0)
  contributions GoalContribution[]
}

model GoalContribution {
  id     String   @id @default(cuid())
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId String
  date   DateTime
  amount Float
}

// --- Holdings: the piece that gets auto-updated by the cron job ---
model Holding {
  id           String          @id @default(cuid())
  name         String          // e.g. "S&P 500 Index Fund"
  account      String?         // e.g. "Fidelity IRA", "Fidelity Brokerage" — lets you track the same fund separately per account
  symbol       String?         // e.g. "VOO" — used by the cron job to look up price. Leave blank for manual-only tracking.
  shares       Float           @default(0) // computed from contributions ÷ price-at-purchase, when symbol is set
  currentValue Float           @default(0)
  entries      HoldingEntry[]  // contributions (money put in)
  history      HoldingValue[]  // value over time, appended by cron + manual updates
}

model HoldingEntry {
  id        String  @id @default(cuid())
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  amount    Float
}

model HoldingValue {
  id        String   @id @default(cuid())
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  value     Float
  source    String   @default("manual") // "manual" | "cron"
}

model Recurring {
  id            String    @id @default(cuid())
  type          String
  category      String
  amount        Float
  frequency     String    // "weekly" | "monthly" | "yearly"
  startDate     DateTime
  endDate       DateTime?
  lastGenerated DateTime?
  paused        Boolean   @default(false)
  paymentMethod String    @default("cash")
  cardId        String?
  bankAccountId String?
  checkNumber   String?
  note          String?
}

model Settings {
  id                  String @id @default("singleton")
  location            String @default("")
  currency            String @default("$")
  charityDefaultPct   Float  @default(10)
  defaultTaxProfileId String?
}

model TaxProfile {
  id    String @id @default(cuid())
  label String
  rate  Float
}

model NetWorthSnapshot {
  id    String   @id @default(cuid())
  date  DateTime
  value Float
}

model CharityEntry {
  id     String   @id @default(cuid())
  date   DateTime
  type   String   // "owed" | "given"
  kind   String   @default("cash") // "cash" | "time" | "other" — how it was given, for "given" entries
  amount Float
  note   String?
}
