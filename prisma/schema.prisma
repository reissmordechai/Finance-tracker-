// Prisma schema for the standalone finance tracker.
// Multi-user: every top-level table is scoped by userId. Run
// `npm run prisma:push` after setting DATABASE_URL to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Supabase, Neon, Railway, etc. all work here
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   // PBKDF2 hash, hex-encoded
  passwordSalt String   // random per-user salt, hex-encoded
  role         String   @default("user") // "admin" | "user" — the first person to ever sign up becomes admin automatically
  approved     Boolean  @default(false)  // new signups need an admin to approve them before they can log in
  blocked      Boolean  @default(false)  // admin can block an existing account at any time
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())
}

model Category {
  id       String  @id @default(cuid())
  userId   String
  name     String
  type     String  // "income" | "expense"
  parentId String? // set when this is a sub-account (e.g. "Electric" under "Utilities")
  @@unique([userId, name, type])
}

model Transaction {
  id             String   @id @default(cuid())
  userId         String
  type           String   // "income" | "expense"
  date           DateTime
  category       String
  amount         Float
  note           String?
  vendor         String?
  paymentMethod  String   @default("cash") // "cash" | "debit" | "card" | "check" | "other"
  paymentOther   String?  // free-text description when paymentMethod = "other"
  cardId         String?
  bankAccountId  String?
  checkNumber    String?
  taxRate        Float?
  taxAmount      Float?
  receiptImage   String?  // base64 or a URL if you move to real file storage
  splitGroupId   String?
  splitIndex     Int?
  splitCount     Int?
  recurringId    String?
  tags           String?  // comma-separated, e.g. "tax deductible,reimbursable"
  currencyCode   String?  // e.g. "EUR" — set only when this was entered in a non-base currency
  originalAmount Float?   // the amount as entered, before conversion to your base currency
  deletedAt      DateTime? // soft-delete — set instead of removing, so it can be restored from Trash
  items          Item[]
  createdAt      DateTime @default(now())
}

model Item {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  name          String
  qty           Float
  unit          String
  unitPrice     Float
}

model Card {
  id                String   @id @default(cuid())
  userId            String
  name              String
  limit             Float    @default(0)
  currencyCode      String   @default("USD")
  dueDay            Int?
  statementDay      Int?     // day of month the statement closes/is generated — usually a few weeks before dueDay
  amountDue         Float    @default(0)
  apr               Float?   // annual % rate, optional — used by the payoff planner
  autoPay           Boolean  @default(false)
  autoPayDay        Int?     // day of month the auto-payment goes out
  autoPayAccountId  String?  // which BankAccount it's paid from
  autoPayType       String?  // "full" | "statement" — pay the full current balance, or just what was on the last statement
  payments          CardPayment[]
}

model CardPayment {
  id            String   @id @default(cuid())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String
  date          DateTime
  amount        Float
  fromAccountId String?
  checkNumber   String?
  note          String?
}

model BankAccount {
  id              String    @id @default(cuid())
  userId          String
  name            String
  balance         Float     @default(0)
  currencyCode    String    @default("USD")
  apy             Float?    // annual % yield, optional — e.g. 3 for a 3% savings/money market account
  lastConfirmedAt DateTime  @default(now()) // when the balance was last manually entered/confirmed — the estimate grows from here
}

model Transfer {
  id              String   @id @default(cuid())
  userId          String
  fromAccountId   String
  toAccountId     String
  amount          Float    // deducted from source, in source's currency
  convertedAmount Float    // credited to destination, in destination's currency
  date            DateTime
  note            String?
}

model Vendor {
  id     String @id @default(cuid())
  userId String
  name   String
  @@unique([userId, name])
}

model Budget {
  id       String  @id @default(cuid())
  userId   String
  category String
  limit    Float
  rollover Boolean @default(false)
  @@unique([userId, category])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  targetAmount Float
  targetDate   DateTime?
  savedAmount  Float     @default(0)
  contributions GoalContribution[]
}

model GoalContribution {
  id     String   @id @default(cuid())
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId String
  date   DateTime
  amount Float
}

// --- Holdings: the piece that gets auto-updated by the cron job ---
model Holding {
  id           String          @id @default(cuid())
  userId       String
  name         String          // e.g. "S&P 500 Index Fund"
  account      String?         // e.g. "Fidelity IRA", "Fidelity Brokerage" — lets you track the same fund separately per account
  symbol       String?         // e.g. "VOO" — used by the cron job to look up price. Leave blank for manual-only tracking.
  currencyCode String          @default("USD")
  shares       Float           @default(0) // computed from contributions ÷ price-at-purchase, when symbol is set
  currentValue Float           @default(0)
  entries      HoldingEntry[]  // contributions (money put in)
  history      HoldingValue[]  // value over time, appended by cron + manual updates
  recurring    RecurringHolding[]
}

model RecurringHolding {
  id            String    @id @default(cuid())
  holding       Holding   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId     String
  amount        Float
  frequency     String    // "weekly" | "monthly" | "yearly"
  startDate     DateTime
  endDate       DateTime?
  lastGenerated DateTime?
  paused        Boolean   @default(false)
}

model HoldingEntry {
  id        String  @id @default(cuid())
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  amount    Float
}

model HoldingValue {
  id        String   @id @default(cuid())
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  value     Float
  source    String   @default("manual") // "manual" | "cron"
}

model Recurring {
  id            String    @id @default(cuid())
  userId        String
  type          String
  category      String
  amount        Float
  currencyCode  String?   // e.g. "EUR" — set only when this rule posts in a non-base currency
  frequency     String    // "weekly" | "monthly" | "yearly"
  startDate     DateTime
  endDate       DateTime?
  lastGenerated DateTime?
  paused        Boolean   @default(false)
  paymentMethod String    @default("cash")
  cardId        String?
  bankAccountId String?
  checkNumber   String?
  note          String?
  postTo        String    @default("transaction") // "transaction" | "holding" | "charity"
  holdingId     String?   // used when postTo = "holding" — which holding to contribute into
}

model Settings {
  userId              String    @id
  location            String    @default("")
  currency            String    @default("$")
  baseCurrencyCode    String    @default("USD") // e.g. "USD", "EUR" — used for foreign-currency conversion
  charityDefaultPct   Float     @default(10)
  lastExportDate      DateTime?
  defaultTaxProfileId String?
}

model ShoppingItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  note      String?
  category  String?  // optional link to a budget account
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaxProfile {
  id     String @id @default(cuid())
  userId String
  label  String
  rate   Float
}

model NetWorthSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  value  Float
}

model Loan {
  id          String  @id @default(cuid())
  userId      String
  name        String  // e.g. "Mortgage", "Car loan", "Student loan"
  principal   Float   // original amount borrowed
  balance     Float   // current remaining balance
  apr         Float?  // annual % rate, optional
  minPayment  Float?
  dueDay      Int?
}

model CharityEntry {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  type          String   // "owed" | "given"
  kind          String   @default("cash") // "cash" | "time" | "other" — how it was given, for "given" entries
  amount        Float
  note          String?
  transactionId String?  // links back to the Transaction that triggered it, so it can show inline
}
