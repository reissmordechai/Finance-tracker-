generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id     String @id @default(cuid())
  name   String
  type   String
  @@unique([name, type])
}

model Transaction {
  id             String   @id @default(cuid())
  type           String
  date           DateTime
  category       String
  amount         Float
  note           String?
  vendor         String?
  paymentMethod  String   @default("cash")
  cardId         String?
  bankAccountId  String?
  checkNumber    String?
  taxRate        Float?
  taxAmount      Float?
  receiptImage   String?
  splitGroupId   String?
  splitIndex     Int?
  splitCount     Int?
  recurringId    String?
  items          Item[]
  createdAt      DateTime @default(now())
}

model Item {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  name          String
  qty           Float
  unit          String
  unitPrice     Float
}

model Card {
  id         String   @id @default(cuid())
  name       String
  limit      Float    @default(0)
  dueDay     Int?
  amountDue  Float    @default(0)
  payments   CardPayment[]
}

model CardPayment {
  id            String   @id @default(cuid())
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String
  date          DateTime
  amount        Float
  fromAccountId String?
  checkNumber   String?
  note          String?
}

model BankAccount {
  id      String @id @default(cuid())
  name    String
  balance Float  @default(0)
}

model Vendor {
  id   String @id @default(cuid())
  name String @unique
}

model Budget {
  id       String @id @default(cuid())
  category String @unique
  limit    Float
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Float
  targetDate   DateTime?
  savedAmount  Float     @default(0)
}

model Holding {
  id           String          @id @default(cuid())
  name         String
  symbol       String?
  shares       Float           @default(0)
  currentValue Float           @default(0)
  entries      HoldingEntry[]
  history      HoldingValue[]
}

model HoldingEntry {
  id        String  @id @default(cuid())
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  amount    Float
}

model HoldingValue {
  id        String   @id @default(cuid())
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  holdingId String
  date      DateTime
  value     Float
  source    String   @default("manual")
}

model Recurring {
  id            String    @id @default(cuid())
  type          String
  category      String
  amount        Float
  frequency     String
  startDate     DateTime
  lastGenerated DateTime?
  paused        Boolean   @default(false)
  paymentMethod String    @default("cash")
  cardId        String?
  bankAccountId String?
  checkNumber   String?
  note          String?
}

model Settings {
  id                  String @id @default("singleton")
  location            String @default("")
  defaultTaxProfileId String?
}

model TaxProfile {
  id    String @id @default(cuid())
  label String
  rate  Float
}
