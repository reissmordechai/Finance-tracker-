# Database — from Supabase, Neon, Railway, etc. (any Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# The password you'll type to log into your own app
APP_PASSWORD="choose-something-only-you-know"

# Random string used to sign the login cookie — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-string"

# API key from alphavantage.co (free tier) — used to look up stock prices
STOCK_API_KEY="your-alphavantage-api-key"

# Random string that protects your cron endpoint from being called by anyone else
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-string"
